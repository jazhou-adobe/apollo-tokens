  "overrides": {
    "font-sans": {
      "$type": "fontFamily",
      "$value": "var(--font-b612), ui-sans-serif, system-ui, sans-serif",
      "$description": "B612 (400, 700), the face drawn for cockpit displays: body text, labels, controls, and every numeral read-out. Equal-width digits and a narrow colon."
    },
    "font-display": {
      "$type": "fontFamily",
      "$value": "var(--font-big-shoulders-stencil), 'Arial Narrow', Arial, sans-serif",
      "$description": "Big Shoulders Stencil (700, 800): punctuation only, for the display line, the wordmark and short panel titles, in sentence case. Never for numerals, buttons, labels or reading text."
    },
    "type-heading-lg-family": {
      "$type": "fontFamily",
      "$value": "var(--sb-font-sans)",
      "$description": "Page headings stay in B612, the operational face; stencil is kept for short panel titles (heading-md) and the display line."
    },
    "type-numeral-xl-family": {
      "$type": "fontFamily",
      "$value": "var(--sb-font-sans)",
      "$description": "Numerals stay in B612, never stencil: the running split must read at a glance."
    },
    "type-numeral-xl-weight": {
      "$type": "fontWeight",
      "$value": "var(--sb-font-weight-bold)",
      "$description": "B612 ships 700 only, so heavy numerals would be synthesised."
    },
    "type-numeral-lg-family": {
      "$type": "fontFamily",
      "$value": "var(--sb-font-sans)",
      "$description": "Counter and read-out numerals in B612."
    },
    "type-numeral-lg-weight": {
      "$type": "fontWeight",
      "$value": "var(--sb-font-weight-bold)",
      "$description": "B612 ships 700 only."
    },
    "type-numeral-md-family": {
      "$type": "fontFamily",
      "$value": "var(--sb-font-sans)",
      "$description": "Row and cell numerals in B612."
    },
    "radius-sm": {
      "$type": "dimension",
      "$value": "0.125rem",
      "$description": "Stamped-plate corner: chips, badges, Length cells, rating steps."
    },
    "radius-md": {
      "$type": "dimension",
      "$value": "0.1875rem",
      "$description": "Buttons, inputs, cards: barely eased steel corners."
    },
    "radius-lg": {
      "$type": "dimension",
      "$value": "0.25rem",
      "$description": "Panels, sheets and the Tap Pad: deck plates, not soft cards."
    },
    "elevation-raised": {
      "$type": "shadow",
      "$value": "0 2px 0 0 var(--sb-shadow)",
      "$description": "A hard ledge under a plate set proud of the deck; no soft blur."
    },
    "elevation-overlay": {
      "$type": "shadow",
      "$value": "0 18px 36px -14px var(--sb-shadow)",
      "$description": "Dialogs, sheets, popovers, menus and toasts lift off the deck."
    }
  },
