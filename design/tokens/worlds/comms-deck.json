  "overrides": {
    "font-sans": {
      "$type": "fontFamily",
      "$value": "var(--font-archivo), ui-sans-serif, system-ui, sans-serif",
      "$description": "Archivo (variable wght 100–900, wdth 62–125): the plain engineering grotesque of console placards, for reading text, Questions, labels and controls"
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "var(--font-martian-mono), ui-monospace, monospace",
      "$description": "Martian Mono (variable wght 100–800, wdth 75–112.5): channel callsigns, Round ids, timers and code, set at 87.5% width by the skin"
    },
    "font-condensed": {
      "$type": "fontFamily",
      "$value": "var(--font-big-shoulders-stencil), 'Arial Narrow', sans-serif",
      "$description": "Big Shoulders Stencil (variable 100–900): stencilled panel lettering for display, section headings, channel numbers and the app bar plate"
    },
    "type-strip-header-family": {
      "$type": "fontFamily",
      "$value": "var(--font-archivo), 'Arial Narrow', sans-serif",
      "$description": "Strip headers stay in Archivo, narrowed to 75% width by the skin, so Round titles on paper read cleanly instead of in stencil"
    },
    "type-heading-lg-weight": {
      "$type": "fontWeight",
      "$value": 800,
      "$description": "Stencil section headings in the heavy cut (Big Shoulders Stencil ships 800)"
    },
    "type-mono-size": {
      "$type": "dimension",
      "$value": "0.8125rem",
      "$description": "Martian Mono runs wide; one step smaller keeps ids and code at the core's line length"
    },
    "type-mono-sm-size": {
      "$type": "dimension",
      "$value": "0.71875rem",
      "$description": "Callsign plates and timer readouts, sized for the wide mono"
    },
    "letter-spacing-caps": {
      "$type": "dimension",
      "$value": "0.08em",
      "$description": "Engraved plate lettering is tracked open"
    },
    "letter-spacing-tight": {
      "$type": "dimension",
      "$value": "0.02em",
      "$description": "Stencil display type needs open tracking so the bridges stay legible"
    },
    "radius-sm": {
      "$type": "dimension",
      "$value": "0.1875rem",
      "$description": "Moulded bakelite edges: keys, plates and chips"
    },
    "radius-md": {
      "$type": "dimension",
      "$value": "0.3125rem",
      "$description": "Controls, cards and attachments: pressed-steel panel corners"
    },
    "elevation-raised": {
      "$type": "shadow",
      "$value": "inset 0 0.0625rem 0 var(--comms-deck-bevel), 0 0.125rem 0.3125rem var(--hh-shadow)",
      "$description": "An enamel panel or key: a worn top bevel plus a short drop. Decorative only"
    },
    "elevation-overlay": {
      "$type": "shadow",
      "$value": "inset 0 0.0625rem 0 var(--comms-deck-bevel), 0 0.75rem 1.75rem var(--hh-shadow)",
      "$description": "A console sub-panel swung out over the deck. Decorative only"
    },
    "elevation-live": {
      "$type": "shadow",
      "$value": "0 0 0.5rem var(--hh-live)",
      "$description": "A tight lamp halo for live state only (connection lamp, live counts)"
    }
  },
