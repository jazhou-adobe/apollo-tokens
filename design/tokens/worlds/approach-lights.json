  "overrides": {
    "font-sans": {
      "$type": "fontFamily",
      "$value": "var(--font-archivo), ui-sans-serif, system-ui, sans-serif",
      "$description": "Archivo (400, 700): body text, labels and controls. A sturdy grotesque with the feel of stencilled deck signage, clear in glare."
    },
    "font-display": {
      "$type": "fontFamily",
      "$value": "var(--font-barlow-condensed), 'Arial Narrow', Arial, sans-serif",
      "$description": "Barlow Condensed (700, 800): display, headings and every numeral read-out, in tabular figures like an instrument readout."
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "var(--font-martian-mono), ui-monospace, monospace",
      "$description": "Martian Mono (400, 700): data-plate labels, captions, metric keys and code."
    },
    "type-display-size": {
      "$type": "dimension",
      "$value": "3rem",
      "$description": "Condensed display set larger so it carries the same weight as the core grotesque."
    },
    "type-heading-lg-size": {
      "$type": "dimension",
      "$value": "2rem",
      "$description": "Condensed section titles, one step up from the core."
    },
    "type-heading-md-size": {
      "$type": "dimension",
      "$value": "1.375rem",
      "$description": "Condensed card and sheet titles, one step up from the core."
    },
    "type-numeral-xl-size": {
      "$type": "dimension",
      "$value": "5rem",
      "$description": "The running split in a condensed face: taller figures in the same width."
    },
    "type-numeral-lg-size": {
      "$type": "dimension",
      "$value": "2.75rem",
      "$description": "Counter and read-out numerals in the condensed face."
    },
    "type-numeral-md-size": {
      "$type": "dimension",
      "$value": "1.625rem",
      "$description": "Row numerals in the condensed face."
    },
    "radius-sm": {
      "$type": "dimension",
      "$value": "0.125rem",
      "$description": "Machined plate corner: chips, badges, fields."
    },
    "radius-md": {
      "$type": "dimension",
      "$value": "0.25rem",
      "$description": "Buttons, cards and the light housing."
    },
    "radius-lg": {
      "$type": "dimension",
      "$value": "0.5rem",
      "$description": "Panels, trays, sheets and the Tap Pad console."
    },
    "elevation-raised": {
      "$type": "shadow",
      "$value": "0 2px 0 0 var(--sb-shadow), 0 6px 14px -10px var(--sb-shadow)",
      "$description": "A worn plate bolted proud of the deck: a hard bottom edge and a short contact shadow."
    },
    "elevation-overlay": {
      "$type": "shadow",
      "$value": "0 2px 0 0 var(--sb-shadow), 0 20px 40px -14px var(--sb-shadow)",
      "$description": "Dialogs, sheets, menus and toasts lifted off the deck."
    }
