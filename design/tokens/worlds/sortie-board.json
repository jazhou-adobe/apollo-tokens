    "surface-shelf-foreground": { "$type": "color", "$value": "#ece7da" },
    "surface-tray": { "$type": "color", "$value": "#313a43" },
    "surface-tray-foreground": { "$type": "color", "$value": "#f1ecdf" },
    "primary": { "$type": "color", "$value": "#ece7da" },
    "primary-foreground": { "$type": "color", "$value": "#1e2328" },
    "secondary": { "$type": "color", "$value": "#343d46" },
    "secondary-foreground": { "$type": "color", "$value": "#ece7da" },
