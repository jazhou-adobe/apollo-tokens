    "destructive": { "$type": "color", "$value": "#ff9c8f" },
    "destructive-foreground": { "$type": "color", "$value": "#1e2328" },
    "border": { "$type": "color", "$value": "#8a949d" },
    "input": { "$type": "color", "$value": "#262d34" },
    "ring": { "$type": "color", "$value": "#f0c64f" },
    "success": { "$type": "color", "$value": "#86cfc0" },
    "success-foreground": { "$type": "color", "$value": "#0e2220" },
    "warning": { "$type": "color", "$value": "#dcd49c" },
    "warning-foreground": { "$type": "color", "$value": "#22201a" },
