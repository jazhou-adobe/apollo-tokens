    "tap-pad-foreground": { "$type": "color", "$value": "#f4efe2" },
    "shadow": { "$type": "color", "$value": "#0b0e1166" },
    "scrim": { "$type": "color", "$value": "#0b0e11b3" },
    "chart-1": { "$type": "color", "$value": "#82b8e6" },
    "chart-2": { "$type": "color", "$value": "#7ecb93" },
    "chart-3": { "$type": "color", "$value": "#e9ba4a" },
    "chart-4": { "$type": "color", "$value": "#c7a6e8" },
    "chart-5": { "$type": "color", "$value": "#b7bcb8" }
  },
  "overrides": {
    "font-sans": {
      "$type": "fontFamily",
      "$value": "var(--font-ibm-plex-sans-condensed), 'Arial Narrow', sans-serif",
      "$description": "IBM Plex Sans Condensed (400, 700): the typeset body of a briefing schedule. Reading text, labels and controls; ships tabular figures, so it also sets every numeral read-out."
    },
    "font-display": {
      "$type": "fontFamily",
      "$value": "var(--font-sofia-sans-extra-condensed), 'Arial Narrow', sans-serif",
      "$description": "Sofia Sans Extra Condensed (700, 800): the board's stencil-free condensed headline face for display, headings, board column heads and button legends."
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "var(--font-ibm-plex-mono), ui-monospace, monospace",
      "$description": "IBM Plex Mono (400, 700): callsign-style Swim IDs, plate labels, metric keys and formulas, like a teleprinter line."
    },
    "type-display-size": {
      "$type": "dimension",
      "$value": "3rem",
      "$description": "Extra-condensed letters set larger so the board title carries the same weight as the core display."
    },
    "type-display-line-height": {
      "$type": "number",
      "$value": 0.95,
      "$description": "Tight schedule-board leading for capital headlines."
    },
    "type-heading-lg-size": {
      "$type": "dimension",
      "$value": "2.125rem",
      "$description": "Condensed section heads set larger to hold their place on the board."
    },
    "type-heading-lg-line-height": {
      "$type": "number",
      "$value": 1,
      "$description": "Board headings sit on one tight line."
    },
    "type-heading-md-size": {
      "$type": "dimension",
      "$value": "1.5rem",
      "$description": "Card and widget heads in the condensed face, set a step larger than the core."
    },
    "type-heading-md-line-height": {
      "$type": "number",
      "$value": 1.1,
      "$description": "Tight leading for condensed heads."
    },
    "type-body-size": {
      "$type": "dimension",
      "$value": "1.0625rem",
      "$description": "Condensed body text set a sixteenth larger so a line holds the core's legibility."
    },
    "type-body-sm-size": {
      "$type": "dimension",
      "$value": "0.9375rem",
      "$description": "Small text in the condensed face, a step above the core so captions stay readable poolside."
    },
    "type-label-size": {
      "$type": "dimension",
      "$value": "0.9375rem",
      "$description": "Labels in the condensed face, a step above the core."
    },
    "type-numeral-xl-family": {
      "$type": "fontFamily",
      "$value": "var(--sb-font-sans)",
      "$description": "The running split in IBM Plex Sans Condensed tabular figures, like the time column of a launch schedule."
    },
    "type-numeral-xl-size": {
      "$type": "dimension",
      "$value": "5rem",
      "$description": "Condensed figures set larger; the split read-out still caps the size to fit a phone column."
    },
    "type-numeral-xl-weight": {
      "$type": "fontWeight",
      "$value": 700,
      "$description": "Plex Sans Condensed Bold, the heaviest loaded cut of the numeral face."
    },
    "type-numeral-lg-family": {
      "$type": "fontFamily",
      "$value": "var(--sb-font-sans)",
      "$description": "Counts on Tap Pad keys and read-outs in Plex Sans Condensed tabular figures."
    },
    "type-numeral-lg-weight": {
      "$type": "fontWeight",
      "$value": 700,
      "$description": "Plex Sans Condensed Bold, a loaded cut."
    },
    "type-numeral-md-family": {
      "$type": "fontFamily",
      "$value": "var(--sb-font-sans)",
      "$description": "Length splits, rating steps and figures in Plex Sans Condensed tabular figures."
    },
    "radius-sm": {
      "$type": "dimension",
      "$value": "0.125rem",
      "$description": "Board slots and typeset tags are nearly square."
    },
    "radius-md": {
      "$type": "dimension",
      "$value": "0.1875rem",
      "$description": "Buttons, inputs and cards: the eased corner of a cut acrylic plate."
    },
    "radius-lg": {
      "$type": "dimension",
      "$value": "0.3125rem",
      "$description": "Panels, sheets and the Tap Pad: a mounted board panel, barely rounded."
    },
    "radius-pill": {
      "$type": "dimension",
      "$value": "0.25rem",
      "$description": "No pills on the board: avatars, switches, rating steps and progress tracks become squared plates. Circles drawn in SVG (the trend dial) are unaffected."
    },
    "elevation-raised": {
      "$type": "shadow",
      "$value": "0 1px 0 0 var(--sb-shadow), 0 2px 0 0 var(--sb-shadow)",
      "$description": "A plate screwed to the board: two hard contact lines, no blur, no glow."
    },
    "elevation-overlay": {
      "$type": "shadow",
      "$value": "0 2px 0 0 var(--sb-shadow), 0 18px 32px -14px var(--sb-shadow)",
      "$description": "A briefing card lifted off the board: one hard edge plus a short soft drop."
    }
  },
