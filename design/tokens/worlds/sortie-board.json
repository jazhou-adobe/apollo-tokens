{
  "label": "Sortie Board",
  "order": 3,
  "$description": "A briefing-room launch schedule: dense typeset sortie rows, callsign-style Swim IDs, condensed type on matte slate. Every Swim, Length and Set reads like a line on the ready-room board.",
  "signature": "A Swim prints in as a sortie row. On the Tap Pad each Length prints into the Length strip cell by cell as its wall tap lands, and the finish touch feeds the whole strip through on a manila paper band and stamps it Printed. Undo takes the line back off the board.",
  "colorScheme": "dark",
  "color": {
    "background": { "$type": "color", "$value": "#22282e" },
    "foreground": { "$type": "color", "$value": "#ece7da" },
    "surface-card": { "$type": "color", "$value": "#2f373f" },
    "surface-card-foreground": { "$type": "color", "$value": "#f1ecdf" },
    "surface-panel": { "$type": "color", "$value": "#283037" },
    "surface-panel-foreground": { "$type": "color", "$value": "#ece7da" },
