{
  "$description": "Splitbook design tokens (DTCG). Source of truth for tokens/themes.css; validation/validate-design-system.mjs checks parity, contrast and guardrails.",
  "meta": {
    "name": "Splitbook Pace Clock tokens",
    "selectorContract": "html[data-theme='<theme-name>']",
    "paletteContract": "html[data-theme='splitbook-<slug>'][data-palette='<id>'] (worlds only)",
    "densityContract": "[data-density='compact'] on the Admin console only",
    "cssNaming": {
      "semantic.color.<role>": "--sb-<role>",
      "primitive.space.<n>": "--sb-space-<n>",
      "primitive.radius.<n>": "--sb-radius-<n>",
      "primitive.borderWidth.<n>": "--sb-border-width-<n>",
      "primitive.font.<n>": "--sb-font-<n>",
      "primitive.fontWeight.<n>": "--sb-font-weight-<n>",
      "primitive.motion.<n>": "--sb-motion-<n>",
      "primitive.easing.<n>": "--sb-easing-<n>",
      "primitive.opacity.<n>": "--sb-opacity-<n>",
      "typography.<n>": "--sb-type-<n>-size | -line-height | -weight | -family",
      "density.<n>": "--sb-density-<n>",
      "elevation.<n>": "--sb-elevation-<n>",
      "layout.<n>": "--sb-layout-<n>",
      "layer.<n>": "--sb-layer-<n>",
      "component.<n>": "--sb-<n>",
      "breakpoint.<n>": "not a CSS variable; media queries and Tailwind --breakpoint-<n> use the literal value"
    },
    "themes": [
      "splitbook-light",
      "splitbook-deck"
    ]
  },
  "contrast": {
    "$description": "Documented pairs checked by validation/validate-design-system.mjs in every theme, world and colour option. Every <role>/<role>-foreground pair (and foreground on background) is checked automatically at text.minimum. Ratios are truncated, never rounded up.",
    "text": {
      "minimum": 4.5,
      "pairs": [
        [
          "foreground",
          "input"
        ],
        [
          "muted-foreground",
          "background"
        ],
        [
          "muted-foreground",
          "surface-card"
        ],
        [
          "muted-foreground",
          "surface-panel"
        ],
        [
          "muted-foreground",
          "surface-shelf"
        ],
        [
          "muted-foreground",
          "surface-tray"
        ],
        [
          "muted-foreground",
          "muted"
        ],
        [
          "muted-foreground",
          "tap-pad"
        ]
      ]
    },
    "nonText": {
      "minimum": 3,
      "pairs": [
        [
          "border",
          "background"
        ],
        [
          "border",
          "surface-card"
        ],
        [
          "border",
          "surface-panel"
        ],
        [
          "border",
          "surface-shelf"
        ],
        [
          "border",
          "surface-tray"
        ],
        [
          "border",
          "input"
        ],
        [
          "border",
          "tap-pad"
        ],
        [
          "ring",
          "background"
        ],
        [
          "ring",
          "surface-card"
        ],
        [
          "ring",
          "surface-panel"
        ],
        [
          "ring",
          "surface-shelf"
        ],
        [
          "ring",
          "surface-tray"
        ],
        [
          "ring",
          "input"
        ],
        [
          "ring",
          "tap-pad"
        ],
        [
          "live",
          "surface-card"
        ],
        [
          "live",
          "tap-pad"
        ],
        [
          "metric",
          "surface-card"
        ],
        [
          "metric",
          "tap-pad"
        ],
        [
          "improvement",
          "surface-card"
        ],
        [
          "improvement",
          "tap-pad"
        ],
        [
          "fault",
          "surface-card"
        ],
        [
          "fault",
          "tap-pad"
        ],
        [
          "chart-1",
          "surface-card"
        ],
        [
          "chart-1",
          "surface-panel"
        ],
        [
          "chart-2",
          "surface-card"
        ],
        [
          "chart-2",
          "surface-panel"
        ],
        [
          "chart-3",
          "surface-card"
        ],
        [
          "chart-3",
          "surface-panel"
        ],
        [
          "chart-4",
          "surface-card"
        ],
        [
          "chart-4",
          "surface-panel"
        ],
        [
          "chart-5",
          "surface-card"
        ],
        [
          "chart-5",
          "surface-panel"
        ]
      ]
    },
    "glare": {
      "$description": "Glare grade: in these themes every text pair must reach this ratio (WCAG AAA), so text stays legible in sun on a wet screen.",
      "minimum": 7,
      "themes": [
        "splitbook-deck"
      ]
    }
  },
  "primitive": {
    "color": {
      "$description": "Raw palette. Token authors use it; screens never do. Values live in themes.<name>.color.",
      "chalk": {
        "$type": "color",
        "$value": "#f4f5f1",
        "$description": "Chalk-tile white."
      },
      "ink": {
        "$type": "color",
        "$value": "#121517",
        "$description": "Ink black: the clock's black hand."
      },
      "hand-red": {
        "$type": "color",
        "$value": "#c4241a",
        "$description": "Pace-clock red hand (live)."
      },
      "hand-blue": {
        "$type": "color",
        "$value": "#1a55b5",
        "$description": "Pace-clock blue hand (metric)."
      },
      "hand-green": {
        "$type": "color",
        "$value": "#1a7438",
        "$description": "Pace-clock green hand (improvement)."
      },
      "safety-yellow": {
        "$type": "color",
        "$value": "#ffd21a",
        "$description": "Safety yellow: the live figures on Deck's LED plate (live-foreground)."
      },
      "led-face": {
        "$type": "color",
        "$value": "#0a0c0d",
        "$description": "The black face of an LED pace clock: Deck's live plate (live)."
      }
    },
    "space": {
      "1": {
        "$type": "dimension",
        "$value": "0.25rem",
        "$description": "Hairline gap"
      },
      "2": {
        "$type": "dimension",
        "$value": "0.5rem",
        "$description": "Tight gap inside controls"
      },
      "3": {
        "$type": "dimension",
        "$value": "0.75rem",
        "$description": "Inline gap"
      },
      "4": {
        "$type": "dimension",
        "$value": "1rem",
        "$description": "Default gap"
      },
      "5": {
        "$type": "dimension",
        "$value": "1.25rem",
        "$description": "Roomy inline gap"
      },
      "6": {
        "$type": "dimension",
        "$value": "1.5rem",
        "$description": "Section gap"
      },
      "8": {
        "$type": "dimension",
        "$value": "2rem",
        "$description": "Large section gap"
      },
      "10": {
        "$type": "dimension",
        "$value": "2.5rem",
        "$description": "Page gutter"
      },
      "12": {
        "$type": "dimension",
        "$value": "3rem",
        "$description": "Major section break"
      },
      "16": {
        "$type": "dimension",
        "$value": "4rem",
        "$description": "Hero break"
      }
    },
    "radius": {
      "sm": {
        "$type": "dimension",
        "$value": "0.25rem",
        "$description": "Pool-tile corner: chips, badges, Length cells, small controls."
      },
      "md": {
        "$type": "dimension",
        "$value": "0.375rem",
        "$description": "Buttons, inputs, cards."
      },
      "lg": {
        "$type": "dimension",
        "$value": "0.625rem",
        "$description": "Panels, trays, sheets, the Tap Pad."
      },
      "pill": {
        "$type": "dimension",
        "$value": "999px",
        "$description": "Fully round: avatars, switches, progress tracks, rating steps, dials."
      }
    },
    "borderWidth": {
      "thin": {
        "$type": "dimension",
        "$value": "1px",
        "$description": "Container and control boundary."
      },
      "thick": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "Inputs, selected chips, the Length strip, Tap Pad keys."
      },
      "heavy": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "The T-line axis between paired panels and the clock hands; never a side-stripe accent."
      }
    },
    "font": {
      "sans": {
        "$type": "fontFamily",
        "$value": "var(--font-atkinson-next), ui-sans-serif, system-ui, sans-serif",
        "$description": "Atkinson Hyperlegible Next (400, 700), self-hosted in app/fonts.ts: body text, labels, controls. Built for low-vision legibility, so it holds up in glare."
      },
      "display": {
        "$type": "fontFamily",
        "$value": "var(--font-schibsted-grotesk), 'Arial Narrow', Arial, sans-serif",
        "$description": "Schibsted Grotesk (700, 800), self-hosted in app/fonts.ts: display, headings and every numeral read-out. Ships tnum, so numerals use font-variant-numeric: tabular-nums."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "var(--font-atkinson-mono), ui-monospace, monospace",
        "$description": "Atkinson Hyperlegible Mono (400, 700), self-hosted in app/fonts.ts: metric keys, formulas and Configuration version IDs in the Admin console."
      }
    },
    "fontWeight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400,
        "$description": "Body text (Atkinson Hyperlegible Next 400)."
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700,
        "$description": "Labels, headings and emphasis: Atkinson 700 and Schibsted Grotesk 700."
      },
      "heavy": {
        "$type": "fontWeight",
        "$value": 800,
        "$description": "Display and the big numerals: Schibsted Grotesk 800. Only the display face loads 800; never set it on sans or mono text."
      }
    },
    "motion": {
      "fast": {
        "$type": "duration",
        "$value": "120ms",
        "$description": "Press feedback and small state changes."
      },
      "standard": {
        "$type": "duration",
        "$value": "180ms",
        "$description": "Default UI transition."
      },
      "panel": {
        "$type": "duration",
        "$value": "240ms",
        "$description": "Dialogs, sheets and popovers entering or leaving."
      },
      "flash": {
        "$type": "duration",
        "$value": "320ms",
        "$description": "The one-off acknowledgement when a wall tap or counter tap lands; never loops."
      },
      "pulse": {
        "$type": "duration",
        "$value": "1400ms",
        "$description": "Skeleton shimmer; runs a bounded number of times."
      },
      "stagger": {
        "$type": "duration",
        "$value": "40ms",
        "$description": "Delay between siblings that enter together; capped at six steps."
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$description": "Default for a state change that starts and ends on screen."
      },
      "enter": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          0,
          1
        ],
        "$description": "Something arriving: quick start, gentle settle, no overshoot."
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [
          0.3,
          0,
          1,
          1
        ],
        "$description": "Something leaving: gentle start, quick finish."
      },
      "linear": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          1,
          1
        ],
        "$description": "Constant rate: spinners and the sweep of an elapsed-time hand."
      },
      "drawer": {
        "$type": "cubicBezier",
        "$value": [
          0.32,
          0.72,
          0,
          1
        ],
        "$description": "Edge-anchored sheets: fast departure from the edge, long soft landing."
      }
    },
    "opacity": {
      "disabled": {
        "$type": "number",
        "$value": 0.55,
        "$description": "Disabled controls; always paired with a text reason when it blocks a task."
      },
      "ghost": {
        "$type": "number",
        "$value": 0.5,
        "$description": "The \"then\" hand and earlier series on a trend, behind the \"now\" values."
      }
    }
  },
  "semantic": {
    "color": {
      "background": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.background}",
        "$description": "Page base behind every container: chalk-tile white in both core themes (positive polarity). Pairs with foreground (4.5:1; 7:1 in Deck)."
      },
      "foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.foreground}",
        "$description": "Ink: body text and icons on background. The clock's black hand."
      },
      "surface-card": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.surface-card}",
        "$description": "Cards and the first surface a reader meets. Pairs with surface-card-foreground."
      },
      "surface-card-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.surface-card-foreground}",
        "$description": "Text on surface-card (4.5:1)."
      },
      "surface-panel": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.surface-panel}",
        "$description": "Grout-grey panels that group content beside cards. Pairs with surface-panel-foreground."
      },
      "surface-panel-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.surface-panel-foreground}",
        "$description": "Text on surface-panel (4.5:1)."
      },
      "surface-shelf": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.surface-shelf}",
        "$description": "Cool lane-grey shelf for secondary lists and filters. Pairs with surface-shelf-foreground."
      },
      "surface-shelf-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.surface-shelf-foreground}",
        "$description": "Text on surface-shelf (4.5:1)."
      },
      "surface-tray": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.surface-tray}",
        "$description": "Bottom action tray in the one-handed reach zone. Pairs with surface-tray-foreground."
      },
      "surface-tray-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.surface-tray-foreground}",
        "$description": "Text on surface-tray (4.5:1)."
      },
      "primary": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.primary}",
        "$description": "The one primary action per view (ink, never a hand colour). Pairs with primary-foreground."
      },
      "primary-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.primary-foreground}",
        "$description": "Label on primary (4.5:1)."
      },
      "secondary": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.secondary}",
        "$description": "Secondary actions. Its boundary comes from border. Pairs with secondary-foreground."
      },
      "secondary-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.secondary-foreground}",
        "$description": "Label on secondary (4.5:1)."
      },
      "muted": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.muted}",
        "$description": "Quiet fills: tracks, skeletons, disabled wells. Pairs with muted-foreground."
      },
      "muted-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.muted-foreground}",
        "$description": "Secondary text on background, every surface, muted and tap-pad (4.5:1)."
      },
      "accent": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.accent}",
        "$description": "Selection and hover tint for rows, chips and nav items; never a status. Pairs with accent-foreground."
      },
      "accent-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.accent-foreground}",
        "$description": "Text on accent (4.5:1)."
      },
      "destructive": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.destructive}",
        "$description": "Destructive actions (delete a Swim, discard a Draft). Not a Fault. Pairs with destructive-foreground."
      },
      "destructive-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.destructive-foreground}",
        "$description": "Label on destructive (4.5:1)."
      },
      "border": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.border}",
        "$description": "Control and container boundaries: 3:1 against background, every surface, input and tap-pad."
      },
      "input": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.input}",
        "$description": "Text field fill. Foreground on input holds 4.5:1; border around it holds 3:1."
      },
      "ring": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.ring}",
        "$description": "Focus ring: 3:1 against background, every surface, input and tap-pad."
      },
      "success": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.success}",
        "$description": "Saved and published confirmations. Pairs with success-foreground; always with a word or icon."
      },
      "success-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.success-foreground}",
        "$description": "Text on success (4.5:1)."
      },
      "warning": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.warning}",
        "$description": "Cautions that need a decision (unsaved Draft, offline). Pairs with warning-foreground."
      },
      "warning-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.warning-foreground}",
        "$description": "Text on warning (4.5:1)."
      },
      "info": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.info}",
        "$description": "Neutral notices and help. Pairs with info-foreground."
      },
      "info-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.info-foreground}",
        "$description": "Text on info (4.5:1)."
      },
      "live": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.live}",
        "$description": "Red hand in Light; in Deck a near-black LED plate whose figures are safety yellow (live-foreground). Recording now: the live Tap Pad state and the running split only. 3:1 against surface-card and tap-pad."
      },
      "live-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.live-foreground}",
        "$description": "Text on live (4.5:1)."
      },
      "metric": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.metric}",
        "$description": "Blue hand: a captured metric value or the Focus metric. 3:1 against surface-card and tap-pad."
      },
      "metric-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.metric-foreground}",
        "$description": "Text on metric (4.5:1)."
      },
      "improvement": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.improvement}",
        "$description": "Green hand: better than before (trend gains). Never used for plain success. 3:1 against surface-card and tap-pad."
      },
      "improvement-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.improvement-foreground}",
        "$description": "Text on improvement (4.5:1)."
      },
      "fault": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.fault}",
        "$description": "An observer-noted Fault: a note, never a referee's call; distinct from destructive. Always with a flag shape and label. 3:1 against surface-card and tap-pad."
      },
      "fault-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.fault-foreground}",
        "$description": "Text on fault (4.5:1)."
      },
      "tap-pad": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.tap-pad}",
        "$description": "The Tap Pad surface: the clock face that wall taps and counters sit on. Pairs with tap-pad-foreground."
      },
      "tap-pad-foreground": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.tap-pad-foreground}",
        "$description": "Text and key labels on tap-pad (4.5:1)."
      },
      "shadow": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.shadow}",
        "$description": "Decorative elevation colour only; never a boundary."
      },
      "scrim": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.scrim}",
        "$description": "Translucent backdrop behind a modal dialog or sheet; text never sits on it."
      },
      "chart-1": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.chart-1}",
        "$description": "Categorical series 1 (3:1 against surface-card and surface-panel; every series is also labelled)."
      },
      "chart-2": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.chart-2}",
        "$description": "Categorical series 2 (3:1 against surface-card and surface-panel)."
      },
      "chart-3": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.chart-3}",
        "$description": "Categorical series 3 (3:1 against surface-card and surface-panel)."
      },
      "chart-4": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.chart-4}",
        "$description": "Categorical series 4 (3:1 against surface-card and surface-panel)."
      },
      "chart-5": {
        "$type": "color",
        "$value": "{themes.splitbook-light.color.chart-5}",
        "$description": "Categorical series 5 (3:1 against surface-card and surface-panel)."
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{primitive.font.display}",
        "fontSize": "2.5rem",
        "lineHeight": 1.05,
        "fontWeight": "{primitive.fontWeight.heavy}"
      },
      "$description": "Page titles on hero and home screens."
    },
    "heading-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{primitive.font.display}",
        "fontSize": "1.75rem",
        "lineHeight": 1.15,
        "fontWeight": "{primitive.fontWeight.bold}"
      },
      "$description": "Section titles."
    },
    "heading-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{primitive.font.display}",
        "fontSize": "1.25rem",
        "lineHeight": 1.25,
        "fontWeight": "{primitive.fontWeight.bold}"
      },
      "$description": "Card, panel and sheet titles."
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{primitive.font.sans}",
        "fontSize": "1.125rem",
        "lineHeight": 1.55,
        "fontWeight": "{primitive.fontWeight.regular}"
      },
      "$description": "Lead paragraphs and Swimmer-facing summaries."
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{primitive.font.sans}",
        "fontSize": "1rem",
        "lineHeight": 1.5,
        "fontWeight": "{primitive.fontWeight.regular}"
      },
      "$description": "Default reading text."
    },
    "body-sm": {
      "$type": "typography",
