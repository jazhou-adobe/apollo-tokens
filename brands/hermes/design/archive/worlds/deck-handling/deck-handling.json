  "overrides": {
    "font-sans": {
      "$type": "fontFamily",
      "$value": "var(--font-public-sans), ui-sans-serif, system-ui, sans-serif",
      "$description": "Public Sans (variable 100–900; 400 and 600 used): reading text, Questions, labels, controls and navigation, in sentence case. A plain government-document grotesque, like a handling-room procedures sheet."
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "var(--font-jetbrains-mono), ui-monospace, monospace",
      "$description": "JetBrains Mono (variable 100–800; 400 and 500 used): callsigns, ids, timers, deck spots and code at the core mono sizes, tabular numerals."
    },
    "font-condensed": {
      "$type": "fontFamily",
      "$value": "var(--font-barlow-semi-condensed), 'Arial Narrow', sans-serif",
      "$description": "Barlow Semi Condensed (static 600 and 700): drafting lettering for strip headers, holder status words, headings and the board name. Short legends only."
    },
    "type-display-weight": {
      "$type": "fontWeight",
      "$value": "var(--hh-font-weight-bold)",
      "$description": "Display set in Barlow Semi Condensed 700, a real cut; drafting lettering, not poster weight."
    },
    "font-weight-heavy": {
      "$type": "fontWeight",
      "$value": 700,
      "$description": "This world loads no 800 cut. Holder status words and the app bar brand ask for heavy; 700 keeps them on a real Barlow Semi Condensed cut instead of a synthesised bold."
    },
    "letter-spacing-caps": {
      "$type": "dimension",
      "$value": "0.08em",
      "$description": "Caps tracking for short condensed legends (status words, badges, deck spots), as template lettering is spaced."
    },
    "radius-sm": {
      "$type": "dimension",
      "$value": "0.125rem",
      "$description": "Template, chip and key corners: cut plastic, barely eased."
    },
    "radius-md": {
      "$type": "dimension",
      "$value": "0.1875rem",
      "$description": "Controls, cards and attachments: machined, tighter than the core."
    },
    "radius-lg": {
      "$type": "dimension",
      "$value": "0.375rem",
      "$description": "Dialogs, sheets and large panels."
    },
    "elevation-raised": {
      "$type": "shadow",
      "$value": "0 0.0625rem 0.25rem 0 var(--hh-shadow)",
      "$description": "A plastic template resting on plexiglass: soft contact depth, no hard offset edge. Decorative only."
    },
    "elevation-overlay": {
      "$type": "shadow",
      "$value": "0 0.5rem 1.5rem -0.25rem var(--hh-shadow)",
      "$description": "A placard lifted off the board: one soft drop, tighter than the core. Decorative only."
    }
  },
  "palette": {
    "label": "Night Deck",
    "$description": "Night Deck: flight deck under night ops lighting. Non-skid deck slate, cream craft templates in dark ink, deck-line yellow for the primary action. Holders are worn-paint ochre, steel, grey and green so they hold 3:1 against both the cream template and the dark deck."
  },
