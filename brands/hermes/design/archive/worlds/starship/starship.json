{
  "label": "Starship Hermes",
  "order": 3,
  "$description": "The courier god as a ship's emblem. Engraved hull lettering and a meander on the outside vertical edges, in terracotta and soot, with parchment reading planes.",
  "signature": "When a Round is sent back, a winged-sandal dispatch seal is struck on its departing strip, then the strip leaves the bay; the seal stays beside the Answered status in the bay confirmation.",
  "colorScheme": "dark",
  "palette": {
    "label": "Soot & Terracotta"
  },
  "overrides": {
    "font-sans": {
      "$type": "fontFamily",
      "$value": "var(--font-instrument-sans), ui-sans-serif, system-ui, sans-serif",
      "$description": "Instrument Sans (variable 400–700): reading text, Questions, labels, controls, strip headers and headings. The one operational face"
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "var(--font-ibm-plex-mono), ui-monospace, monospace",
      "$description": "IBM Plex Mono (400, 500, 600, 700): callsigns, Round ids, timers and code, like stencilled hull serials"
    },
    "font-condensed": {
      "$type": "fontFamily",
      "$value": "var(--font-instrument-sans), ui-sans-serif, system-ui, sans-serif",
      "$description": "One operational face: strip headers, headings and status words use Instrument Sans, the reading face, so the ship's classical lettering stays reserved for identity"
    },
    "font-weight-heavy": {
      "$type": "fontWeight",
      "$value": 700,
      "$description": "Instrument Sans stops at 700, so the heaviest named weight is 700 and nothing is synthesised"
    },
    "type-display-family": {
      "$type": "fontFamily",
      "$value": "var(--font-marcellus-sc), 'Times New Roman', serif",
      "$description": "Marcellus SC, the restricted identity face: display lettering and the ship's name only, engraved into the hull plate"
    },
    "type-display-weight": {
      "$type": "fontWeight",
      "$value": "var(--hh-font-weight-regular)",
      "$description": "Marcellus SC ships one weight; the engraving reads from a soft highlight, never synthesised bold"
    },
    "radius-md": {
      "$type": "dimension",
      "$value": "0.1875rem",
      "$description": "Controls and plates: machined, barely eased corners"
    },
    "radius-lg": {
      "$type": "dimension",
      "$value": "0.3125rem",
      "$description": "Dialogs, sheets and frames: hull plates with a slightly larger ease"
    },
    "elevation-raised": {
      "$type": "shadow",
      "$value": "0 0.25rem 0.75rem -0.375rem var(--hh-shadow)",
      "$description": "Soft contact depth under cards and strips; no hard offset edge. Decorative only"
    },
    "elevation-overlay": {
      "$type": "shadow",
      "$value": "0 0.75rem 2rem -0.5rem var(--hh-shadow)",
      "$description": "Dialogs, sheets, popovers, menus: soft lift off the hull. Decorative only"
    }
  },
